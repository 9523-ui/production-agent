# 复制为 .env（已被 .gitignore 忽略），按需修改
APP_ENV=dev
LLM_BACKEND=fake
# 接真实模型时改成 deepseek 并填自己的 Key；Key 只从环境变量读取
# LLM_BACKEND=deepseek
# DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

HOST=127.0.0.1
PORT=8010
LOG_LEVEL=INFO
DB_PATH=data/prodagent.db

# prod 环境必须配置，调用方需带 Authorization: Bearer <AUTH_TOKEN>
# AUTH_TOKEN=

# M8 分级鉴权（可选）：AUTH_TOKEN 兼容映射为 leader；三令牌任一配置即开启鉴权
# AUTH_TOKEN_STAFF=
# AUTH_TOKEN_CUSTOMER=
# 演示身份切换令牌（仅 dev 生效，prod 一律忽略）
# ENABLE_DEMO_ROLE_TOKENS=0

REQUEST_TIMEOUT_S=20
TOOL_TIMEOUT_S=5
MAX_ROUNDS=5
MAX_CONCURRENCY=8
PER_SESSION_QUOTA=30
SESSION_TTL_S=3600
DAILY_BUDGET_CNY=5
MAX_MESSAGE_CHARS=2000
CIRCUIT_THRESHOLD=3
CIRCUIT_COOLDOWN_S=8
RETRY_MAX=2
RETRY_BASE_MS=120
PRICE_IN_CNY_PER_1K=0.002
PRICE_OUT_CNY_PER_1K=0.008
